  "source" : "import StackbarKit\nimport Foundation\n\n/// The time in the places you work with. The menu bar shows one city; the\n/// panel shows them all with the offset from you and whether it is working\n/// hours there, drawn on your own day so the overlap shows at a glance.\n/// Cities are chosen in Settings. A slider in the panel moves every clock\n/// forward or back, to answer \"what time is it there when it's 3pm here\".\n/// Needs nothing from the host.\n@main\nfinal class WorldClock: StackbarPlugin {\n    static let manifest = Manifest(\n        id: \"io.navbytes.stackbar.plugins.world-clock\",\n        name: \"World Clock\",\n        version: \"1.7.0\",\n        summary: \"The time in the cities you work with, with offsets and working hours.\",\n        surfaces: [.menuBar, .panel, .settings, .widget],\n        triggers: [.launch, .every(.seconds(30)), .wake],\n        minimumStackbar: \"0.32.0\",\n        homepage: \"https://github.com/navbytes/stackbar-plugins/tree/main/Productivity/WorldClock\",\n        accent: .violet,\n        symbol: \"globe\"\n    )\n\n    // MARK: Previews\n\n    static let previews: [PreviewScene<WorldClock>] = [\n        PreviewScene(\"hero\", \"Every city you work with, and their working hours\") { plugin in\n            plugin.zones = [\"America/Los_Angeles\", \"America/New_York\", \"Europe/London\", \"Asia/Kolkata\", \"Asia/Tokyo\"]\n        },\n        PreviewScene(\"plan\", \"Slide to find a time that works everywhere\") { plugin in\n            plugin.zones = [\"America/Los_Angeles\", \"America/New_York\", \"Europe/London\", \"Asia/Kolkata\", \"Asia/Tokyo\"]\n            plugin.offsetHours = 3\n        },\n        PreviewScene(\"widget\", \"Your cities on the desktop\", surface: .widget) { _ in },\n        PreviewScene(\"menu-bar\", \"In place of the macOS clock\", surface: .menuBar) { plugin in\n            plugin.menuBarZone = WorldClock.here\n            plugin.showDate = true\n            plugin.showWeekday = true\n            plugin.showCity = false\n            plugin.showIcon = false\n        },\n    ]\n\n    /// The real time, from the last refresh.\n    var realNow = Date()\n    /// How far the panel's time-travel slider has moved every clock, in hours.\n    var offsetHours = 0.0\n    /// The moment every clock shows: now, or where the slider points.\n    var now: Date { realNow.addingTimeInterval(offsetHours * 3600) }\n    @Stored(\"zones\") var zones: [String] = [\"America/Los_Angeles\", \"America/New_York\", \"Europe/London\", \"Asia/Kolkata\"]\n    @Stored(\"menuBarZone\") var menuBarZone = \"Europe/London\"\n    @Stored(\"use24Hour\") var use24Hour = true\n    @Stored(\"workStart\") var workStart = 9.0\n    @Stored(\"workEnd\") var workEnd = 18.0\n    // The menu-bar clock, set like the macOS one.\n    @Stored(\"showDate\") var showDate = false\n    @Stored(\"showWeekday\") var showWeekday = false\n    @Stored(\"showSeconds\") var showSeconds = false\n    @Stored(\"showAMPM\") var showAMPM = true\n    @Stored(\"showCity\") var showCity = true\n    @Stored(\"showIcon\") var showIcon = true\n    /// A Unicode date pattern that replaces the options above when set.\n    @Stored(\"menuBarFormat\") var menuBarFormat = \"\"\n    /// The name each added city was typed as, by zone, when it isn't the city's own.\n    @Stored(\"names\") var names: [String: String] = [:]\n    /// Why the last add failed, shown under the field until the next add.\n    var addError: String?\n    /// Formatters by zone and clock, made on first use: a clock is drawn on every redraw.\n    private var timeFormatters: [String: DateFormatter] = [:]\n\n    func refresh() async throws {\n        realNow = Date()\n    }\n\n    let theme = Theme.violet\n\n    /// `menuBarZone` for this Mac's own time, which follows the Mac as it travels.\n    static let here = \"here\"\n\n    /// The city in the menu bar: the one picked, or the first city once that one is removed.\n    /// A picked city this Mac no longer knows falls back to the first one it does.\n    var shownZone: TimeZone? {\n        if menuBarZone == Self.here { return .current }\n        return validZones.first { $0.identifier == menuBarZone } ?? validZones.first\n    }\n\n    /// The menu bar's pattern: the custom one, or one built from the options\n    /// in the order this Mac's language writes them.\n    var menuBarPattern: String {\n        let custom = menuBarFormat.trimmingCharacters(in: .whitespaces)\n        if !custom.isEmpty { return custom }\n        return Self.pattern(weekday: showWeekday, date: showDate, use24Hour: use24Hour, seconds: showSeconds, amPM: showAMPM)\n    }\n\n    static func pattern(weekday: Bool, date: Bool, use24Hour: Bool, seconds: Bool, amPM: Bool, locale: Locale = .current) -> String {\n        let day = (weekday ? \"EEE\" : \"\") + (date ? \"dMMM\" : \"\")\n        let time = (use24Hour ? \"HHmm\" : \"hmm\") + (seconds ? \"ss\" : \"\")\n        let datePart = day.isEmpty ? \"\" : (DateFormatter.dateFormat(fromTemplate: day, options: 0, locale: locale) ?? day)\n        var timePart = DateFormatter.dateFormat(fromTemplate: time + (use24Hour ? \"\" : \"a\"), options: 0, locale: locale) ?? \"HH:mm\"\n        if use24Hour {\n            // A 12-hour language can still answer with a period; 24-hour has none.\n            timePart = timePart.replacingOccurrences(of: \"a\", with: \"\").trimmingCharacters(in: .whitespaces)\n        } else if !amPM {\n            timePart = timePart.replacingOccurrences(of: \"\\u{202F}a\", with: \"\").replacingOccurrences(of: \" a\", with: \"\")\n                .replacingOccurrences(of: \"a \", with: \"\").replacingOccurrences(of: \"a\", with: \"\").trimmingCharacters(in: .whitespaces)\n        }\n        // A comma between the date and the time reads oddly in a menu bar.\n        let joined = [datePart, timePart].filter { !$0.isEmpty }.joined(separator: \" \")\n        return joined.replacingOccurrences(of: \",\", with: \"\")\n    }\n\n    var menuBar: ViewContent {\n        if let zone = shownZone {\n            HStack(spacing: Space.xs) {\n                if showIcon { Image(systemName: \"globe\") }\n                if showCity, menuBarZone != Self.here { Text(city(zone.identifier)) }\n                // Without a zone the clock follows the Mac's own, even after it changes.\n                Clock(menuBarPattern, timeZone: menuBarZone == Self.here ? nil : zone)\n            }\n        } else {\n            Label(\"\", symbol: \"globe\").role(.secondary)\n        }\n    }\n\n    var panel: ViewContent {\n        PanelHeader(\"\\(time(now, in: .current)) here\", subtitle: (offsetHours == 0 ? \"\" : Self.shift(offsetHours) + \" · \") + \"\\(now.formatted(.dateTime.weekday(.wide).day().month(.abbreviated))) · \\(validZones.count) \\(validZones.count == 1 ? \"city\" : \"cities\")\",\n                    symbol: \"globe\", theme: theme) {\n            Picker(\"Clock\", options: [\"12h\", \"24h\"], selection: use24Hour ? \"24h\" : \"12h\", style: .segmented) { self.use24Hour = $0 == \"24h\" }\n                .frame(width: 96)\n        }\n        if validZones.isEmpty {\n            EmptyState(\"Add a city\", symbol: \"globe\", message: \"Type a city or a time zone. The menu bar shows the one you tap.\", theme: theme) {\n                TextField(\"City or time zone, like Tokyo\") { submitted in self.add(submitted) }\n                if let addError { Text(addError).style(.caption).role(.warning) }\n            }\n        } else {\n            VStack(spacing: Space.s) {\n                ForEach(validZones) { zone in card(zone) }\n            }\n            timeTravel\n            Text(\"Bars show each city's working hours across your day, and the tick is your time\\(offsetHours == 0 ? \" now\" : \" on the slider\"). Tap a city to show it in the menu bar.\").role(.secondary).typography(.caption)\n        }\n    }\n\n    /// A slider that moves every clock, so you can find a time that works\n    /// everywhere. Steps are half an hour; Now puts it back.\n    @ViewBuilder var timeTravel: ViewContent {\n        HStack(spacing: Space.s) {\n            Image(systemName: \"clock.arrow.2.circlepath\").opacity(0.6)\n            Slider(offsetHours == 0 ? \"Slide to see another time\" : Self.shift(offsetHours) + \" · \\(time(now, in: .current)) here\", value: offsetHours, in: -12...12, step: 0.5, key: \"time-travel\", live: true) { value in\n                self.offsetHours = value\n            }\n            if offsetHours != 0 {\n                ActionButton(\"Now\", theme: theme) { self.offsetHours = 0 }\n            }\n            ActionButton(\"Copy times\", symbol: \"doc.on.doc\", theme: theme, key: \"copy-times\") {\n                Stackbar.copy(self.timesText(at: self.now))\n                Stackbar.hud(\"Copied\")\n            }\n        }\n    }\n\n    /// Every city's time at `date`, one line to paste into an invite, with a\n    /// note where a city is on another day from yours.\n    func timesText(at date: Date) -> String {\n        let here = day(in: .current, at: date)\n        let lines = validZones.map { zone -> String in\n            let theirs = day(in: zone, at: date)\n            let note = theirs == here ? \"\" : theirs > here ? \" (next day)\" : \" (previous day)\"\n            return \"\\(city(zone.identifier)) \\(time(date, in: zone))\\(note)\"\n        }\n        return ([\"\\(time(date, in: .current)) here\"] + lines).joined(separator: \" · \")\n    }\n\n    /// `+3h`, `−1h 30m`.\n    static func shift(_ hours: Double) -> String {\n        let minutes = Int((abs(hours) * 60).rounded())\n        let text = minutes % 60 == 0 ? \"\\(minutes / 60)h\" : minutes < 60 ? \"\\(minutes)m\" : \"\\(minutes / 60)h \\(minutes % 60)m\"\n        return (hours > 0 ? \"+\" : \"−\") + text + \" from now\"\n    }\n\n    /// One city as a band of its sky: dawn, day, dusk or night, with the\n    /// sun or moon, a big time, and its working hours on your day.\n    @ViewBuilder func card(_ zone: TimeZone) -> ViewContent {\n        let working = isWorking(zone)\n        let sky = Sky(hour: hour(in: zone))\n        let shown = zone.identifier == shownZone?.identifier\n        Button(key: \"city-\\(zone.identifier)\", action: { self.menuBarZone = zone.identifier }) {\n            VStack(spacing: Space.s + 2) {\n                HStack(spacing: Space.s + 2) {\n                    Image(systemName: sky.symbol).font(size: 20, weight: .semibold).symbolRendering(.multicolor)\n                    VStack(spacing: 1) {\n                        HStack(spacing: Space.xs) {\n                            Text(city(zone.identifier)).typography(.headline)\n                            if shown { Image(systemName: \"menubar.rectangle\").font(size: 10, weight: .semibold).opacity(0.8).accessibilityLabel(\"Shown in the menu bar\") }\n                        }\n                        Text(subtitle(for: zone) + (working ? \" · working\" : \"\")).typography(.caption).opacity(0.8)\n                    }\n                    Spacer()\n                    Text(time(now, in: zone)).typography(Typography(size: 28, weight: .bold, design: .rounded, monospacedDigit: true)).numericTransition()\n                }\n                .frame(fillWidth: true)\n                hoursBar(workingHoursOnYourDay(zone), now: hour(in: .current) / 24, width: 332)\n            }\n            .foreground(.onMedia)\n            .padding(Space.m)\n            .frame(fillWidth: true)\n            .background(sky.paint, in: .roundedRectangle(cornerRadius: Radius.large + 2))\n            .hover(scale: 1.015, highlight: .hex(\"#FFFFFF14\"))\n        }\n        .accessibilityLabel(\"\\(city(zone.identifier)), \\(time(now, in: zone)), \\(working ? \"working hours\" : \"outside working hours\")\")\n    }\n\n    /// Your day as a faint line on the sky, the city's working hours bright\n    /// on it, and a tick at your now.\n    func hoursBar(_ spans: [ClosedRange<Double>], now: Double, width: Double) -> some StackbarView {\n        let tick = 2.0, height = 4.0\n        var pieces: [(width: Double, lit: Bool)] = []\n        var at = 0.0\n        for span in spans.sorted(by: { $0.lowerBound < $1.lowerBound }) {\n            let from = min(max(span.lowerBound, at), 1), to = min(max(span.upperBound, from), 1)\n            if from > at { pieces.append(((from - at) * width, false)) }\n            if to > from { pieces.append(((to - from) * width, true)) }\n            at = to\n        }\n        if at < 1 { pieces.append(((1 - at) * width, false)) }\n        return ZStack(alignment: .start) {\n            HStack(spacing: 0) {\n                ForEach(Array(pieces.enumerated())) { _, piece in\n                    Rectangle().fill(piece.lit ? .hex(\"#FFFFFFD9\") : .hex(\"#FFFFFF33\")).frame(width: max(piece.width, 0), height: height)\n                }\n            }\n            .clipShape(.capsule)\n            HStack(spacing: 0) {\n                Rectangle().fill(.clear).frame(width: max(0, min(now, 1) * width - tick / 2), height: 10)\n                Capsule().fill(.onMedia).frame(width: tick, height: 10).shadow(radius: 2, color: HexColor(\"#00000066\"))\n            }\n        }\n        .frame(width: width, height: 10)\n        .accessibilityLabel(\"Working hours on your day\")\n    }\n\n    /// The city's working hours, moved onto your clock, as fractions of your day.\n    func workingHoursOnYourDay(_ zone: TimeZone) -> [ClosedRange<Double>] {\n        let offset = Double(zone.secondsFromGMT(for: now) - TimeZone.current.secondsFromGMT(for: now)) / 3600\n        let start = (workStart - offset).truncatingRemainder(dividingBy: 24)\n        let from = start < 0 ? start + 24 : start\n        let to = from + Self.workLength(start: workStart, end: workEnd)\n        return to <= 24 ? [from / 24...to / 24] : [from / 24...1, 0...(to - 24) / 24]\n    }\n\n    var widget: ViewContent {\n        Grid(columns: 2, spacing: Space.s) {\n            ForEach(Array(validZones.prefix(4))) { zone in\n                let sky = Sky(hour: hour(in: zone, at: realNow))\n                VStack(spacing: Space.xxs) {\n                    HStack(spacing: Space.xs) {\n                        Image(systemName: sky.symbol).font(size: 11).symbolRendering(.multicolor)\n                        Text(city(zone.identifier)).typography(.caption).opacity(0.85)\n                    }\n                    Text(time(realNow, in: zone)).typography(Typography(size: 22, weight: .bold, design: .rounded, monospacedDigit: true))\n                }\n                .foreground(.onMedia)\n                .padding(horizontal: Space.m - 2, vertical: Space.s)\n                .frame(fillWidth: true, alignment: .leading)\n                .background(sky.paint, in: .roundedRectangle(cornerRadius: Radius.large))\n            }\n        }\n    }\n\n    /// What the menu bar reads right now, for Settings.\n    var menuBarPreview: String {\n        let formatter = DateFormatter()\n        formatter.locale = .current\n        formatter.timeZone = shownZone ?? .current\n        formatter.dateFormat = menuBarPattern\n        return formatter.string(from: Date())\n    }\n\n    static let hours = (0...24).map { String(format: \"%02d:00\", $0) }\n\n    var settings: ViewContent {\n        Section(\"Cities\") {\n            ForEach(zones) { identifier in\n                Row(city(identifier), subtitle: TimeZone(identifier: identifier) == nil ? \"Unknown time zone\" : identifier, symbol: \"mappin\", key: \"zone-\\(identifier)\")\n                    .action(\"Remove\") {\n                        self.zones.removeAll { $0 == identifier }\n                        self.names[identifier] = nil\n                        if self.menuBarZone == identifier { self.menuBarZone = self.validZones.first?.identifier ?? self.menuBarZone }\n                    }\n            }\n            TextField(\"Add a city or time zone, like Tokyo\", text: \"\") { submitted in self.add(submitted) }\n            if let addError { Text(addError).style(.caption).role(.warning) }\n            Text(\"Type a city name (Tokyo, New York) or a zone (Asia/Tokyo).\").style(.caption).role(.secondary)\n        }\n        Section(\"Menu bar\") {\n            Picker(\"Shows\", options: [\"This Mac\"] + validZones.map { city($0.identifier) },\n                   selection: menuBarZone == Self.here ? \"This Mac\" : shownZone.map { city($0.identifier) }, key: \"menu-bar-city\") { choice in\n                self.menuBarZone = choice == \"This Mac\" ? Self.here : self.validZones.first { self.city($0.identifier) == choice }?.identifier ?? self.menuBarZone\n            }\n            Toggle(\"Show the date\", isOn: showDate) { self.showDate = $0 }\n            Toggle(\"Show the day of the week\", isOn: showWeekday) { self.showWeekday = $0 }\n            Toggle(\"Use a 24-hour clock\", isOn: use24Hour) { self.use24Hour = $0 }\n            if !use24Hour { Toggle(\"Show AM/PM\", isOn: showAMPM) { self.showAMPM = $0 } }\n            Toggle(\"Show the seconds\", isOn: showSeconds) { self.showSeconds = $0 }\n            if menuBarZone != Self.here { Toggle(\"Show the city's name\", isOn: showCity) { self.showCity = $0 } }\n            Toggle(\"Show the globe\", isOn: showIcon) { self.showIcon = $0 }\n            TextField(\"Custom format, like EEE d MMM HH:mm\", text: menuBarFormat, key: \"menu-bar-format\") { submitted in\n                self.menuBarFormat = submitted.trimmingCharacters(in: .whitespaces)\n            }\n            Text(\"Now: \\(menuBarPreview). A custom format replaces the options above; leave it empty to use them. y year, MMM month, d day, EEE weekday, HH or h hour, mm minutes, ss seconds, a AM/PM.\")\n                .style(.caption).role(.secondary)\n        }\n        Section(\"Working hours\") {\n            Picker(\"Start\", options: Array(Self.hours.dropLast()), selection: Self.hours[Self.hourIndex(workStart, in: 0...23)], key: \"work-start\") { self.workStart = Double(Self.hours.firstIndex(of: $0) ?? 9) }\n            Picker(\"End\", options: Array(Self.hours.dropFirst()), selection: Self.hours[Self.hourIndex(workEnd, in: 1...24)], key: \"work-end\") { self.workEnd = Double(Self.hours.firstIndex(of: $0) ?? 18) }\n        }\n    }\n\n    var tools: [AgentTool] {\n        AgentTool(\"times\", description: \"The current time in each configured city\") { _ in\n            self.validZones.map { \"\\(self.city($0.identifier)): \\(self.time(self.realNow, in: $0))\" }.joined(separator: \"\\n\")\n        }\n    }\n\n    // MARK: Commands\n\n    var commands: [Command] {\n        Command(\"times\", title: \"World Clock\", subtitle: \"The time in your cities\", symbol: \"globe\", keywords: [\"time\", \"zone\", \"clock\", \"city\", \"timezone\"])\n            .view(search: { _ in try await self.refresh() }) { invocation in\n                let query = invocation.text.lowercased()\n                let zones = self.validZones.filter { query.isEmpty || self.city($0.identifier).lowercased().contains(query) || $0.identifier.lowercased().contains(query) }\n                if zones.isEmpty {\n                    ContentUnavailableView(self.validZones.isEmpty ? \"No cities yet\" : \"No city matches\", symbol: \"globe\", message: self.validZones.isEmpty ? \"Add cities in World Clock's settings.\" : nil)\n                } else {\n                    List(zones) { zone in\n                        Row(self.city(zone.identifier), subtitle: self.subtitle(for: zone, at: self.realNow), symbol: Sky(hour: self.hour(in: zone, at: self.realNow)).symbol, key: zone.identifier)\n                            .badge(self.time(self.realNow, in: zone), role: self.isWorking(zone, at: self.realNow) ? .accent : .secondary)\n                            .action(\"Copy Time\") { Stackbar.copy(\"\\(self.time(self.realNow, in: zone)) in \\(self.city(zone.identifier))\") }\n                            .action(\"Show in Menu Bar\") { self.menuBarZone = zone.identifier }\n                    }\n                }\n            }\n        Command(\"copy-times\", title: \"Copy My Cities' Times\", subtitle: \"The time now in each of your cities\", symbol: \"doc.on.doc\", keywords: [\"time\", \"zone\", \"city\", \"copy\", \"schedule\"]) { _ in\n            self.realNow = Date()\n            return .copy(self.timesText(at: self.realNow))\n        }\n        // \"tokyo\" or \"time in tok\" at the palette's root answers with the time.\n        Command(\"time-in\", title: \"Time In a City\", subtitle: \"World Clock\", symbol: \"globe\", keywords: [\"time\", \"zone\", \"city\"])\n            .view(search: { _ in self.realNow = Date() }) { invocation in\n                List(Array(self.zones(named: invocation.text).prefix(3))) { zone in\n                    Row(self.city(zone.identifier), subtitle: self.time(self.realNow, in: zone) + \" · \" + self.subtitle(for: zone, at: self.realNow),\n                        symbol: Sky(hour: self.hour(in: zone, at: self.realNow)).symbol, key: zone.identifier)\n                        .action(\"Copy Time\") { Stackbar.copy(\"\\(self.time(self.realNow, in: zone)) in \\(self.city(zone.identifier))\") }\n                        .action(self.zones.contains(zone.identifier) ? \"Show in Menu Bar\" : \"Add to World Clock\") {\n                            if self.zones.contains(zone.identifier) { self.menuBarZone = zone.identifier } else { self.zones.append(zone.identifier) }\n                        }\n                }\n            }\n            .rootSearch(section: \"World Clock\", matching: #\"(?i)\\p{L}[\\p{L} .'’-]+\\??\"#)\n            .stackbarOnly()\n    }\n\n    /// Zones a palette query names: a whole city name (\"tokyo\", \"san\n    /// francisco\"), an abbreviation after \"time in\" (\"time in pst\"), or a\n    /// city's start after \"time in\" or before \"time\" (\"time in tok\", \"lond\n    /// time\"). Accents and a question mark don't matter. Your own cities come\n    /// first. Empty for anything else, so ordinary typing shows nothing.\n    func zones(named query: String) -> [TimeZone] {\n        var text = Self.fold(query)\n        var prefix = false\n        for lead in [\"time in \", \"what time is it in \", \"what's the time in \", \"what’s the time in \"] where text.hasPrefix(lead) {\n            text = String(text.dropFirst(lead.count)).trimmingCharacters(in: .whitespaces)\n            prefix = true\n        }\n        if !prefix, text.hasSuffix(\" time\") {\n            text = String(text.dropLast(\" time\".count)).trimmingCharacters(in: .whitespaces)\n            prefix = true\n        }\n        guard text.count >= 2 else { return [] }\n        var found: [String] = []\n        if let identifier = Self.aliases[text] { found.append(identifier) }\n        if prefix, let identifier = Self.shortNames[text] { found.append(identifier) }\n        found += Self.cityIndex.filter { prefix ? $0.key.hasPrefix(text) : $0.key == text }.map(\\.identifier)\n        if prefix { found += Self.aliases.filter { $0.key.hasPrefix(text) }.map(\\.value) }\n        // A name said in full (\"ist\", \"la\") beats a city that only starts with it.\n        let exact = Set([Self.aliases[text], prefix ? Self.shortNames[text] : nil].compactMap { $0 })\n        let mine = Set(zones)\n        func rank(_ zone: String) -> (Int, Int, String) { (exact.contains(zone) ? 0 : 1, mine.contains(zone) ? 0 : 1, zone) }\n        return Array(Set(found)).sorted { rank($0) < rank($1) }.compactMap(TimeZone.init(identifier:))\n    }\n\n    /// Full city names people say, and the zone each one is in. These match\n    /// on their own, as well as after \"time in\".\n    static let aliases: [String: String] = [\n        \"mumbai\": \"Asia/Kolkata\", \"bombay\": \"Asia/Kolkata\", \"delhi\": \"Asia/Kolkata\", \"new delhi\": \"Asia/Kolkata\",\n        \"bangalore\": \"Asia/Kolkata\", \"bengaluru\": \"Asia/Kolkata\", \"chennai\": \"Asia/Kolkata\", \"hyderabad\": \"Asia/Kolkata\", \"pune\": \"Asia/Kolkata\",\n        \"san francisco\": \"America/Los_Angeles\", \"seattle\": \"America/Los_Angeles\", \"san diego\": \"America/Los_Angeles\", \"las vegas\": \"America/Los_Angeles\", \"portland\": \"America/Los_Angeles\",\n        \"washington\": \"America/New_York\", \"boston\": \"America/New_York\", \"miami\": \"America/New_York\", \"atlanta\": \"America/New_York\", \"philadelphia\": \"America/New_York\",\n        \"austin\": \"America/Chicago\", \"dallas\": \"America/Chicago\", \"houston\": \"America/Chicago\",\n        \"beijing\": \"Asia/Shanghai\", \"shenzhen\": \"Asia/Shanghai\", \"guangzhou\": \"Asia/Shanghai\",\n        \"osaka\": \"Asia/Tokyo\", \"kyoto\": \"Asia/Tokyo\",\n        \"munich\": \"Europe/Berlin\", \"frankfurt\": \"Europe/Berlin\", \"hamburg\": \"Europe/Berlin\",\n        \"barcelona\": \"Europe/Madrid\",\n        \"milan\": \"Europe/Rome\",\n        \"geneva\": \"Europe/Zurich\",\n        \"abu dhabi\": \"Asia/Dubai\",\n    ]\n\n    /// Abbreviations. They match only after \"time in\", and in Add, because a\n    /// bare \"sf\" or \"eat\" is more often a word than a city.\n    static let shortNames: [String: String] = [\n        \"nyc\": \"America/New_York\", \"dc\": \"America/New_York\", \"et\": \"America/New_York\", \"est\": \"America/New_York\", \"edt\": \"America/New_York\",\n        \"sf\": \"America/Los_Angeles\", \"la\": \"America/Los_Angeles\", \"pt\": \"America/Los_Angeles\", \"pst\": \"America/Los_Angeles\", \"pdt\": \"America/Los_Angeles\",\n        \"mst\": \"America/Denver\", \"mdt\": \"America/Denver\",\n        \"cst\": \"America/Chicago\", \"cdt\": \"America/Chicago\",\n        \"utc\": \"UTC\", \"gmt\": \"GMT\",\n        \"bst\": \"Europe/London\",\n        \"cet\": \"Europe/Paris\", \"cest\": \"Europe/Paris\",\n        \"ist\": \"Asia/Kolkata\",\n        \"jst\": \"Asia/Tokyo\",\n        \"aest\": \"Australia/Sydney\", \"aedt\": \"Australia/Sydney\",\n        \"hkt\": \"Asia/Hong_Kong\",\n        \"sgt\": \"Asia/Singapore\",\n    ]\n\n    /// Lowercased, without accents, and without the punctuation people type around a name.\n    static func fold(_ text: String) -> String {\n        text.folding(options: [.caseInsensitive, .diacriticInsensitive], locale: nil).trimmingCharacters(in: CharacterSet(charactersIn: \" ?!.\"))\n    }\n\n    /// The city a zone is named for: \"America/New_York\" is \"New York\".\n    static func cityName(_ identifier: String) -> String {\n        (identifier.split(separator: \"/\").last.map(String.init) ?? identifier).replacingOccurrences(of: \"_\", with: \" \")\n    }\n\n    /// Every zone by its folded city name, for matching what people type. Built once.\n    static let cityIndex: [(identifier: String, key: String)] = TimeZone.knownTimeZoneIdentifiers.map { (identifier: $0, key: fold(cityName($0))) }\n\n    // MARK: -\n\n    var validZones: [TimeZone] { zones.compactMap(TimeZone.init(identifier:)) }\n\n    func add(_ text: String) {\n        let trimmed = text.trimmingCharacters(in: .whitespaces)\n        guard !trimmed.isEmpty else { return }\n        let key = Self.fold(trimmed)\n        var match = TimeZone.knownTimeZoneIdentifiers.first { $0.caseInsensitiveCompare(trimmed) == .orderedSame }\n        // What was typed names the city, when the city has no name of its own.\n        var typed: String?\n        if match == nil, let identifier = Self.aliases[key] {\n            match = identifier\n            typed = trimmed.capitalized\n        }\n        if match == nil, let identifier = Self.shortNames[key] {\n            match = identifier\n            typed = trimmed.uppercased()\n        }\n        if match == nil { match = Self.cityIndex.first { $0.key == key }?.identifier }\n        guard let match else {\n            addError = \"No city or time zone called “\\(trimmed)”. Try a nearby big city or a zone like Asia/Tokyo.\"\n            return\n        }\n        guard !zones.contains(match) else {\n            addError = \"\\(city(match)) is already in your list\"\n            return\